module RubyWasm
  module ReleaseBundle
    class Preflight
      TAG: Regexp
      COMMIT: Regexp

      def self.github_time: (String response) -> Time?

      class Refusal < Struct[untyped]
        attr_accessor clause: String
        attr_accessor message: String
      end

      @tag: String
      @build_name: String?
      @today: String
      @existing_tags: Array[String]
      @asset_name: String?
      @archive_members: Array[String]?
      @sibling: String?
      @repository_status: Integer?
      @immutability: [Integer, untyped]?
      @actual_sha256: String?
      @release_commit: String?
      @on_release: bool?
      @frozen_latest_tag: String?
      @latest_tag: String?

      def initialize: (
        tag: String,
        build_name: String?,
        today: String,
        existing_tags: Array[String],
        ?asset_name: String?,
        ?archive_members: Array[String]?,
        ?sibling: String?,
        ?actual_sha256: String?,
        ?repository_status: Integer?,
        ?immutability: [Integer, untyped]?,
        ?release_commit: String?,
        ?on_release: bool?,
        ?frozen_latest_tag: String?,
        ?latest_tag: String?
      ) -> void

      def refusals: () -> Array[Refusal]

      def pass?: () -> bool

      def next_ordinal: (?MatchData? match) -> Integer

      def self.asset_name_for: (String tag, ?MatchData? match) -> String

      def self.stem_for: (String asset_name) -> String

      def self.publish_command: (tag: String, dir: String, asset_name: String, release_commit: String) -> Array[String]

      private

      def target_refusals: () -> Array[Refusal]

      def pointer_refusals: () -> Array[Refusal]

      def asset_refusals: (MatchData match) -> Array[Refusal]

      def sibling_refusals: (String asset_name) -> Array[Refusal]

      def immutability_refusals: () -> Array[Refusal]
    end
  end
end

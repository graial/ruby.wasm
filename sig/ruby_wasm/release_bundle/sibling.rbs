module RubyWasm
  module ReleaseBundle
    module Sibling
      FORM: Regexp

      class Entry
        attr_reader digest: String
        attr_reader name: String

        def initialize: (String digest, String name) -> void
      end

      def self.parse: (String contents) -> Entry?

      def self.line: (String digest, String name) -> String
    end
  end
end

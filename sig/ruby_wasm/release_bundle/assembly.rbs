module RubyWasm
  module ReleaseBundle
    class Assembly
      class Stop < StandardError
      end

      STATED: Array[String]
      DECLARED_KEYS: Array[String]
      CONTRACT_VERSION: Integer

      attr_reader log: Array[String]
      attr_reader refusals: Array[untyped]

      @cap: String
      @input: Hash[String, untyped]
      @dest: String
      @release: String

      def initialize: (capture_dir: String, input: Hash[String, untyped], dest: String, release_checkout: String) -> void
      def run: () -> bool

      private

      def git: (String dir, *String args) -> [String, String]
      def put: (String? src, String dst) -> void
      def copy_tree: (String src, String dst) -> void
      def hashes_text: () -> String
      def manifest_text: (Hash[String, untyped] m) -> String
    end
  end
end

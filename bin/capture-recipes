#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Captures one Build tree under contract v3 (6.0, 6.1, 6.8; ADR-0068,
# ADR-0069), into a capture directory that did not exist.
#
#   bin/capture-recipes <build-tree> <checkout> <capture-dir> <manifest-input.yml>
#
# manifest-input.yml carries what a human states and nothing the capture
# derives: build_name, capture, tools, and the declared path_keys
# (wasi_sdk_path, ruby_src, cc_wrapper, wasi_vfs, wasm_opt). bin/assemble-bundle
# reads the same file.
#
# The link recipe comes from `make -n build-ext` in a Capture copy at
# <build-tree>.capture-copy, never from the tree. The copy is removed when the
# real tree hashes identical afterwards, and kept for diagnosis otherwise.
#
# Exit 0 having written the capture; exit 1 printing every STOP; exit 2 when a
# fact could not be gathered before the copy existed.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "yaml"
require "ruby_wasm/release_bundle/capture_run"

tree, checkout, cap, input_path = ARGV
if [tree, checkout, cap, input_path].any?(&:nil?)
  warn "usage: #{File.basename($PROGRAM_NAME)} <build-tree> <checkout> <capture-dir> <manifest-input.yml>"
  exit 2
end

begin
  input = YAML.safe_load_file(input_path)
  run = RubyWasm::ReleaseBundle::CaptureRun.new(tree: tree, checkout: checkout, capture_dir: cap, input: input)
  ok = run.run
rescue RubyWasm::ReleaseBundle::CaptureRun::Stop, Errno::ENOENT, KeyError => e
  warn "STOP  #{e.message}"
  exit 2
end

run.log.each { |l| puts l }
run.notes.each { |n| puts "note         : #{n}" }
if ok
  puts "OK  #{File.expand_path(cap)}"
  exit 0
end
run.refusals.each { |r| warn "STOP #{r.clause}  #{r.message}" }
exit 1

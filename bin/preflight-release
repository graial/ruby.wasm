#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Refuses a publication that contract section 1 forbids, before anything is
# uploaded.
#
#   bin/preflight-release <tag> <asset-directory> [remote]
#   bin/preflight-release <build-name>-<YYYYMMDD>.<ordinal> ./out
#
# Exit 0 and print the publish command, or exit 1 and print every refusal.
#
# The decision lives in RubyWasm::ReleaseBundle::Preflight and is pure. This
# file only gathers facts: the remote's tags, the repository's immutable-releases
# setting (ADR-0050, through gh), the sibling's bytes, the tarball's
# top level, the build_name and release_commit in the tarball's own
# manifest.yml, whether release carries that commit, the latest pointer, and
# today's UTC date on GitHub's clock (ADR-0042). Keeping those apart is what lets every refusal be reached from a
# spec without a network, and a preflight whose refusals are untested is a
# preflight nobody has seen refuse anything.
#
# It reports the next free ordinal. It never picks one. 1.3 puts uniqueness in
# the ordinal and says publish time is not when to decide what.

require "digest"
require "json"
require "net/http"
require "open3"
require "shellwords"
require "uri"
require "yaml"
require_relative "../lib/ruby_wasm/release_bundle/preflight"

Preflight = RubyWasm::ReleaseBundle::Preflight

tag = ARGV[0]
dir = ARGV[1]
remote = ARGV[2] || "origin"

if tag.nil? || dir.nil?
  warn "usage: #{File.basename($PROGRAM_NAME)} <tag> <asset-directory> [remote]"
  exit 2
end

def run(*cmd)
  out, err, status = Open3.capture3(*cmd)
  unless status.success?
    warn "#{cmd.first} failed: #{err.strip}"
    exit 2
  end
  out
end

# Every tag on the remote, not every release. A tag can exist without a release
# and `gh release create` would fail on it; asking git asks the thing that
# actually has to be free.
existing_tags =
  run("git", "ls-remote", "--tags", remote)
    .lines
    .filter_map { |line| line.split("\t").last&.strip }
    .map { |ref| ref.delete_prefix("refs/tags/").delete_suffix("^{}") }
    .uniq

# ADR-0050: whether immutable releases are enabled. The endpoint needs a token
# with admin read access, and answers 404 when the setting is off, so the
# repository is looked up first; Preflight reads a 404 as "not enabled" only
# after that answered 200. `gh api -i` prints the status line whatever the
# status, and exits non-zero above 299, so the status is read from the output,
# not the exit code. No status line at all (no gh, no auth, no network) stops
# here: that examined nothing.
def gh_api(path)
  out, err, _status = Open3.capture3("gh", "api", "-i", path)
  code = out[%r{\AHTTP/\S+ (\d{3})}, 1]
  unless code
    warn "gh api #{path} gave no HTTP status: #{err.strip}"
    exit 2
  end
  body_text = out.split(/\r?\n\r?\n/, 2)[1].to_s
  body =
    begin
      JSON.parse(body_text)
    rescue JSON::ParserError
      nil
    end
  [code.to_i, body, out]
rescue Errno::ENOENT
  warn "gh is not installed; the preflight needs it to read ADR-0050's setting"
  exit 2
end

url = run("git", "remote", "get-url", remote).strip
slug = url[%r{github\.com[:/]([^/]+/[^/]+?)(?:\.git)?\z}, 1]
unless slug
  warn "#{remote} is #{url}, which is not a GitHub repository"
  exit 2
end
repository_status, _repository, repository_response = gh_api("repos/#{slug}")
immutability = gh_api("repos/#{slug}/immutable-releases").first(2)

match = Preflight::TAG.match(tag)
asset_name = match && Preflight.asset_name_for(tag, match)
asset_path = asset_name && File.join(dir, asset_name)

archive_members = nil
actual_sha256 = nil
sibling = nil
build_name = nil
release_commit = nil

if asset_path && File.exist?(asset_path)
  actual_sha256 = Digest::SHA256.file(asset_path).hexdigest
  # Handed over whole and unparsed: its form is a 1.4 refusal, not something
  # this file may smooth over. binread, so a CRLF arrives as it is on disk.
  sibling_path = "#{asset_path}.sha256"
  sibling = File.binread(sibling_path) if File.exist?(sibling_path)
  archive_members =
    run("tar", "tzf", asset_path)
      .lines
      .map { |entry| entry.strip.split("/").first }
      .compact
      .uniq

  # The Build name the tag is checked against is the bundle's own. A tarball
  # with no readable <stem>/manifest.yml leaves it nil, which is a refusal.
  manifest_member = "#{Preflight.stem_for(asset_name.to_s)}/manifest.yml"
  manifest_yaml, _err, status = Open3.capture3("tar", "xzOf", asset_path, manifest_member)
  if status.success?
    parsed = YAML.safe_load(manifest_yaml)
    if parsed.is_a?(Hash)
      build_name = parsed["build_name"] if parsed["build_name"].is_a?(String)
      release_commit = parsed["release_commit"] if parsed["release_commit"].is_a?(String)
    end
  end
elsif asset_name
  warn "REFUSE 1.3  no #{asset_name} in #{dir}"
  exit 1
end

# ADR-0042: the tag's date is the UTC calendar date the release is published,
# on the clock that writes published_at. No Date header stops here: the local
# clock is what this replaces, so it is no fallback.
now = Preflight.github_time(repository_response)
unless now
  warn "gh api repos/#{slug} gave no readable Date header, so today's UTC date is unknown"
  exit 2
end
today = now.strftime("%Y%m%d")

# ADR-0047: release_commit must be on the remote's release. git answers 0 for
# yes, 1 for no, and anything else (an unknown commit, a shallow clone that
# lacks it) for "could not say", which is a refusal and not a no.
on_release = nil
if release_commit && Preflight::COMMIT.match?(release_commit)
  _out, fetch_err, fetched = Open3.capture3("git", "fetch", "--quiet", remote, "refs/heads/release")
  if fetched.success?
    _o, _e, ancestor = Open3.capture3("git", "merge-base", "--is-ancestor", release_commit, "FETCH_HEAD")
    on_release = true if ancestor.exitstatus == 0
    on_release = false if ancestor.exitstatus == 1
  else
    warn "git fetch #{remote} release failed: #{fetch_err.strip}"
  end
end

# ADR-0048: the pointer, resolved as the postflight resolves it.
latest_uri = URI("https://github.com/#{slug}/releases/latest")
latest_tag =
  begin
    Net::HTTP.start(latest_uri.host, latest_uri.port, use_ssl: true) do |http|
      response = http.request(Net::HTTP::Head.new(latest_uri))
      location = response["location"].to_s
      if response.is_a?(Net::HTTPRedirection) && (t = location[%r{/releases/tag/([^/?#]+)\z}, 1])
        URI.decode_www_form_component(t)
      end
    end
  rescue SocketError, SystemCallError, Net::OpenTimeout, Net::ReadTimeout, OpenSSL::SSL::SSLError => e
    warn "#{latest_uri} could not be read: #{e.message}"
    nil
  end

preflight =
  Preflight.new(
    tag: tag,
    build_name: build_name,
    today: today,
    existing_tags: existing_tags,
    asset_name: asset_name,
    archive_members: archive_members,
    sibling: sibling,
    actual_sha256: actual_sha256,
    repository_status: repository_status,
    immutability: immutability,
    release_commit: release_commit,
    on_release: on_release,
    frozen_latest_tag: ENV["FROZEN_LATEST_TAG"],
    latest_tag: latest_tag
  )

refusals = preflight.refusals

unless refusals.empty?
  refusals.each { |r| warn "REFUSE #{r.clause}  #{r.message}" }
  exit 1
end

puts "OK  #{tag}"
puts "    #{existing_tags.length} tag(s) on #{remote}, none of them this one"
puts "    #{asset_name}  sha256 #{actual_sha256}"
puts "    build_name #{build_name} (from #{Preflight.stem_for(asset_name.to_s)}/manifest.yml)"
puts "    release_commit #{release_commit} is on release"
puts "    latest pointer #{latest_tag}"
puts "    date #{today} is today in UTC on GitHub's clock (checked #{now.strftime("%H:%M")} UTC; publish before 24:00 UTC)"
puts
puts "Publish with (1.2 ordinary release, never a pre-release; ADR-0047 the commit that cut it; ADR-0048 the latest pointer never moves):"
puts Shellwords.join(
  Preflight.publish_command(tag: tag, dir: dir, asset_name: asset_name.to_s, release_commit: release_commit.to_s)
)
